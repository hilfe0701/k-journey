// K-Journey Firestore rules
//
// Journey state is local-only. Firebase is limited to public content delivery
// and operator-managed data; there is no client-owned user document or ACL.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalogues are read-only for every app client.
    match /universities/{universityId} {
      allow read: if true;
      allow write: if false;
    }

    match /missions_catalog/{missionId} {
      allow read: if true;
      allow write: if false;
    }

    // Emergency guidance must remain available on a borrowed phone.
    match /emergency/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Any collection not explicitly listed above is denied by default.
  }
}
