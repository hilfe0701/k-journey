# PostHog (https://posthog.com → Project → API Keys)
EXPO_PUBLIC_POSTHOG_API_KEY=phc_REPLACE_WITH_YOUR_PROJECT_API_KEY
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Firebase config files are NOT in env — they're native files:
#   - iOS: GoogleService-Info.plist (project root)
#   - Android: google-services.json (project root)
# Download both from Firebase Console → Project Settings → Your apps.
