{
  "name": "k-journey",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:web": "KJ_WEB_BUILD=1 APP_ENV=prod expo export --platform web",
    "serve:web": "expo serve",
    "fonts:subset": "bash scripts/subset-fonts.sh",
    "vercel-build": "npm run build:web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "test:e2e:web": "node scripts/e2e-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/noto-serif-kr": "^0.4.3",
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/crashlytics": "^26.3.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "expo": "^57.0.0",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.15",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "^0.511.0",
    "posthog-react-native": "^3.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1308.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "playwright": "^1.62.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
